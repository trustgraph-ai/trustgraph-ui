{
  "name": "trustgraph-ux",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "npm -w @trustgraph/demo run dev",
    "build": "npm -w @trustgraph/client run build && npm -w @trustgraph/react-provider run build && npm -w @trustgraph/react-state run build && npm -w @trustgraph/trustkit run build && npm -w @trustgraph/demo run build",
    "lint": "eslint .",
    "test": "npm -w @trustgraph/client -w @trustgraph/react-provider -w @trustgraph/react-state -w @trustgraph/trustkit run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3"
  }
}
